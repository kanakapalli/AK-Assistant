import Foundation
import os
import TTSKit

/// Speaks answers aloud with a local Qwen3-TTS model (Argmax TTSKit, Core ML, from Hugging Face).
@MainActor
final class SpeechService {
    private var tts: TTSKit?
    private var loadedVariant: String?
    private var speakTask: Task<Void, Never>?
    private let log = Logger(subsystem: "com.natfirst.akassistant", category: "Speech")

    /// Called when an answer finishes being spoken (not when it's stopped early).
    var onFinished: (@MainActor () -> Void)?

    /// Downloads a voice model and returns its local folder.
    static func download(variant id: String, to base: URL, progress: @escaping @Sendable (Double) -> Void) async throws -> URL {
        let variant = TTSModelVariant(rawValue: id) ?? .qwen3TTS_0_6b
        return try await TTSKit.download(
            variant: variant,
            downloadBase: base,
            progressCallback: { p in progress(p.fractionCompleted) }
        )
    }

    /// Loads the voice model if it isn't already, so the first answer starts speaking quickly.
    func prepare(variant id: String, folder: URL) async throws {
        if loadedVariant == id, tts != nil { return }
        let variant = TTSModelVariant(rawValue: id) ?? .qwen3TTS_0_6b
        log.info("Loading voice model \(variant.description, privacy: .public)")
        let config = TTSKitConfig(model: variant, modelFolder: folder, verbose: false, download: false)
        tts = try await TTSKit(config)
        loadedVariant = id
    }

    /// Speaks the text, replacing anything currently being spoken.
    /// TTSKit starts playing the first sentence while it's still generating the rest.
    func speak(_ text: String, voice: String, languageCode: String?) {
        stop()
        guard let tts, !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return }
        let speaker = Qwen3Speaker(rawValue: voice) ?? .ryan
        let language = Self.language(for: languageCode)
        speakTask = Task {
            do {
                var options = GenerationOptions()
                options.chunkingStrategy = .sentence
                _ = try await tts.play(text: text, speaker: speaker, language: language, options: options)
                if !Task.isCancelled { onFinished?() }
            } catch {
                if !Task.isCancelled { NSLog("AK Assistant speech error: \(error)") }
            }
        }
    }

    /// Stops speaking right away.
    func stop() {
        speakTask?.cancel()
        speakTask = nil
        if let tts {
            Task { await tts.audioOutput.stopPlayback(waitForCompletion: false) }
        }
    }

    func unload() {
        stop()
        tts = nil
        loadedVariant = nil
    }

    /// Qwen3-TTS speaks 10 languages; anything else falls back to English.
    private static func language(for code: String?) -> Qwen3Language {
        switch code {
        case "zh": return .chinese
        case "ja": return .japanese
        case "ko": return .korean
        case "de": return .german
        case "fr": return .french
        case "ru": return .russian
        case "pt": return .portuguese
        case "es": return .spanish
        case "it": return .italian
        default: return .english
        }
    }
}
