import AppKit
import SwiftUI

/// A floating panel near the top-right of the screen that shows the AI's answer as it streams in.
/// It never takes focus away from the app you're working in, but its buttons still work.
@MainActor
final class AnswerPanelController {
    private var panel: NSPanel?
    private let size = NSSize(width: 420, height: 300)

    func show(state: AppState) {
        if panel == nil {
            panel = makePanel(state: state)
        }
        position()
        panel?.orderFrontRegardless()
    }

    func hide() {
        panel?.orderOut(nil)
    }

    private func makePanel(state: AppState) -> NSPanel {
        let panel = NSPanel(
            contentRect: NSRect(origin: .zero, size: size),
            styleMask: [.nonactivatingPanel, .borderless],
            backing: .buffered,
            defer: false
        )
        panel.isFloatingPanel = true
        panel.level = .floating
        panel.isOpaque = false
        panel.backgroundColor = .clear
        panel.hasShadow = true
        panel.hidesOnDeactivate = false
        panel.becomesKeyOnlyIfNeeded = true
        panel.isMovableByWindowBackground = true
        panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
        panel.contentView = NSHostingView(rootView: AnswerView().environment(state))
        return panel
    }

    private func position() {
        guard let panel, let screen = NSScreen.main else { return }
        let frame = screen.visibleFrame
        panel.setFrameOrigin(NSPoint(x: frame.maxX - size.width - 16, y: frame.maxY - size.height - 16))
    }
}

struct AnswerView: View {
    @Environment(AppState.self) private var state

    var body: some View {
        VStack(alignment: .leading, spacing: 10) {
            header
            if let reply = state.reply {
                Text(reply.question)
                    .font(.callout)
                    .foregroundStyle(.secondary)
                    .lineLimit(2)

                Divider()

                ScrollView {
                    VStack(alignment: .leading, spacing: 8) {
                        if reply.answer.isEmpty && reply.isStreaming {
                            HStack(spacing: 8) {
                                ProgressView().controlSize(.small)
                                Text("Thinking…").foregroundStyle(.secondary)
                            }
                        } else {
                            Text(markdown(reply.answer))
                                .textSelection(.enabled)
                                .frame(maxWidth: .infinity, alignment: .leading)
                        }
                        if let error = reply.error {
                            Label(error, systemImage: "exclamationmark.triangle")
                                .font(.caption)
                                .foregroundStyle(.orange)
                        }
                    }
                }
                .frame(maxHeight: .infinity)

                footer(reply)
            }
        }
        .padding(16)
        .frame(width: 420, height: 300)
        .background(.regularMaterial, in: RoundedRectangle(cornerRadius: 14))
        .overlay(RoundedRectangle(cornerRadius: 14).strokeBorder(.white.opacity(0.12)))
    }

    private var header: some View {
        HStack {
            Label("AK Assistant", systemImage: "sparkles")
                .font(.headline)
            Spacer()
            Button {
                state.closeAnswer()
            } label: {
                Image(systemName: "xmark.circle.fill")
                    .font(.title3)
                    .foregroundStyle(.secondary)
            }
            .buttonStyle(.plain)
            .help("Close")
        }
    }

    private func footer(_ reply: AssistantReply) -> some View {
        HStack(spacing: 12) {
            Button {
                state.copyAnswer()
            } label: {
                Label("Copy", systemImage: "doc.on.doc")
            }
            .disabled(reply.answer.isEmpty)

            if state.isSpeaking {
                Button {
                    state.stopSpeaking()
                } label: {
                    Label("Stop", systemImage: "stop.fill")
                }
            } else {
                Button {
                    state.speakAgain()
                } label: {
                    Label("Speak", systemImage: "speaker.wave.2")
                }
                .disabled(reply.answer.isEmpty || reply.isStreaming)
            }

            Spacer()

            Button {
                state.newConversation()
            } label: {
                Label("New chat", systemImage: "plus.bubble")
            }
            .help("Forget this conversation. The next question starts fresh.")
        }
        .buttonStyle(.borderless)
        .font(.callout)
    }

    /// Renders simple markdown (bold, italics, code) if the model uses it.
    private func markdown(_ text: String) -> AttributedString {
        let options = AttributedString.MarkdownParsingOptions(interpretedSyntax: .inlineOnlyPreservingWhitespace)
        return (try? AttributedString(markdown: text, options: options)) ?? AttributedString(text)
    }
}
